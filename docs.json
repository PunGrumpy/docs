          "projects/index",
          "projects/docker-doctor",
          "projects/pigo",
          "projects/better-commit",
          "projects/git-bench",
          "projects/verno-studio",
          "projects/logixlysia",
          "projects/og-tester",
          "projects/zero-link",
          "projects/kubernetes-automated-load-balancer",
          "projects/thai-seatizen",
          "projects/try",
          "projects/client-work"
        ]
      },
      {
        "group": "Writing",
        "pages": [
          "writing/index"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/discovery",
          "reference/colophon"
        ]
      }
    ]
  },
