{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PunGrumpy",
  "description": "Engineering reference for Noppakorn Kaewsalabnil (PunGrumpy): profile, work history, projects, writing, and credentials, written for humans and agents.",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#EDEDED",
    "dark": "#0A0A0A"
