    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://pungrumpy.com"
  },
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "index",
          "profile",
          "stack"
        ]
      },
      {
        "group": "Work",
        "pages": [
          "experience",
          "education",
          "achievements"
        ]
      },
      {
        "group": "Projects",
